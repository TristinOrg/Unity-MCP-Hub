<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tristin.MCPManager.UI.ViewModels"
        xmlns:models="using:Tristin.MCPManager.Core.Models"
        xmlns:views="using:Tristin.MCPManager.UI.Views"
        x:Class="Tristin.MCPManager.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Unity MCP Hub"
        Height="600" SizeToContent="Width" CanResize="False">

    <Grid ColumnDefinitions="Auto,Auto">
        <Border Width="380" Padding="14">
            <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <TextBlock Text="Unity Editors" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Refresh" Command="{Binding ScanEditorsCommand}"
                            ToolTip.Tip="Scan running Unity Editors"/>
                    <ToggleButton Grid.Column="2" Content="Activity"
                                  IsChecked="{Binding IsActivityOpen}"
                                  ToolTip.Tip="Toggle Coplay activity for the selected Unity Editor"/>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="4">
                    <Grid>
                        <ListBox ItemsSource="{Binding EditorInstances}" SelectedItem="{Binding SelectedEditor}"
                                 AutomationProperties.Name="Unity Editors"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:EditorInstance">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="4">
                                        <StackPanel Spacing="3" ToolTip.Tip="{Binding ProjectPath}">
                                            <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Opacity="0.72">
                                                <TextBlock Text="{Binding Version}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ProcessId, StringFormat='PID {0}'}" FontSize="12"/>
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding State, Converter={x:Static views:MainWindow.EditorStateBrush}}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="No running Unity Editors found."
                                   IsVisible="{Binding !EditorInstances.Count}"
                                   Margin="12,16" Opacity="0.72" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Content="Connect" Command="{Binding ConnectCommand}" Classes="accent"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,8"/>
                    <Button Grid.Column="1" Content="Disconnect" Command="{Binding DisconnectCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,8"/>
                </Grid>

                <ScrollViewer Grid.Row="2" MaxHeight="64" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="6">
                        <StackPanel IsVisible="{Binding IsConnecting}" Spacing="6">
                            <ProgressBar IsIndeterminate="True"/>
                            <TextBlock Text="{Binding ConnectionStatus}" TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>

                        <TextBlock IsVisible="{Binding StartupError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Text="{Binding StartupError}" Foreground="#fca5a5" TextWrapping="Wrap" FontSize="12"/>
                        <TextBlock IsVisible="{Binding SelectedEditor.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Text="{Binding SelectedEditor.ErrorMessage}" Foreground="#fca5a5"
                                   TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Column="1" Width="360" Padding="14"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0" IsVisible="{Binding IsActivityOpen}">
            <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
                <TextBlock Grid.Row="2" Text="MCP endpoint" FontWeight="SemiBold" FontSize="12"/>
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding McpEndpoint, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12"
                             AutomationProperties.Name="MCP endpoint"/>
                    <Button Grid.Column="1" Content="Copy" Click="CopyEndpoint_Click"
                            ToolTip.Tip="Copy the MCP endpoint to the clipboard"/>
                </Grid>

                <TextBlock Text="Unity · Coplay activity" FontWeight="SemiBold" FontSize="12"/>
                <Border Grid.Row="1" Background="#15151b" CornerRadius="6" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <SelectableTextBlock Text="{Binding LogText}" FontFamily="Consolas"
                                             FontSize="12" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
